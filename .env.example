# HabitatOS MCP Server Environment Configuration

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=habitatos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/habitatos

# MCP Authentication & Server
# MCP_API_KEY=
# MCP_JWT_SECRET=
DEBUG=false

# Email Alerts Configuration (Standard SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# LLM Configuration (Ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Third-party Services (Optional)
# OPENAI_API_KEY=
