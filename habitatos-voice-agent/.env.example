# ── LiveKit (only creds needed — provider keys live in LiveKit Cloud) ──
# Deepgram / Anthropic / Cartesia are configured under
# LiveKit Cloud → Project → Settings → Integrations.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key          # LiveKit Cloud → Project → Settings → Keys
LIVEKIT_API_SECRET=your_livekit_api_secret    # Same page as above

# ── MongoDB ──
MONGODB_URL=mongodb://localhost:27017         # Or your Atlas connection string

# ── FastMCP Server ──
MCP_SERVER_URL=http://localhost:8000/mcp/     # FastMCP streamable-HTTP endpoint
MCP_TIMEOUT=3.0                               # Seconds before MCP call timeout
MCP_API_KEY=your-secret-api-key              # Must match MCP_API_KEY in the server's .env

# ── Cartesia Voice (optional — has a default) ──
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# ── Memory Tuning (optional — have defaults) ──
MAX_CONTEXT_TURNS=20
TOP_K_MEMORIES=3
